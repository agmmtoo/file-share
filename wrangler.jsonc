{
	"$schema": "./node_modules/wrangler/config-schema.json",
  "name": "file-share",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-19",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Share metadata. Replaced KV: a download cap needs an atomic counter, and
	// KV's free tier allows 1,000 writes/day against D1's 100,000 rows/day.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "file-share",
			"database_id": "784aeb6d-03e1-4892-a47d-06da25c334a8",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "file-share"
		}
	],
	// Per-IP rate limits. namespace_id is any number unique within this account;
	// simple.period only accepts 10 or 60 (seconds).
	"ratelimits": [
		{
			"name": "SHARE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "DOWNLOAD_LIMIT",
			"namespace_id": "1002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			// Sign-in / sign-up. Tighter than the others: this one guards credentials.
			"name": "AUTH_LIMIT",
			"namespace_id": "1003",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}